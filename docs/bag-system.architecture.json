    { "dot": "emerald", "title": "配置与状态分离", "items": ["ItemConfig 静态定义全量加载一次、全表复用", "ItemStack 只存运行时状态，堆叠/数量变化不碰配置"] },
    { "dot": "violet", "title": "数据与 UI 解耦", "items": ["Service 变更后发事件，UI 订阅刷新而非每帧轮询", "同一份背包可被多个 UI 同时显示"] },
    { "dot": "amber", "title": "可扩展", "items": ["Container 抽象让背包 / 仓库 / 装备栏都是容器实例", "ConfigProvider 接口可替换表 / JSON / Proto 数据源"] }
