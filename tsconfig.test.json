{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".test-out",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": [
    "./src/Bag/Model/**/*.ts",
    "./src/Bag/Interface/**/*.ts",
    "./src/Bag/Test/**/*.ts",
    "./src/Common/**/*.ts",
    "./test/**/*.ts"
  ]
}
